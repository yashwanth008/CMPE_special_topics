# Option 1 - Gemini API key (AI Studio): https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-key-here

# Option 2 - Vertex AI (recommended for deployment; uses Application Default Credentials)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1

# The Gemini CLI itself reads GEMINI_API_KEY (or Vertex env vars above)
GEMINI_API_KEY=your-key-here
