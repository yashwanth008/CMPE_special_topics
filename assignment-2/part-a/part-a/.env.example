# Get a key at https://openrouter.ai/keys

# Any model id OpenRouter routes to. Cheap + fast defaults:
#   google/gemini-2.5-flash
#   deepseek/deepseek-chat
#   qwen/qwen-2.5-72b-instruct
#   anthropic/claude-3.5-haiku
MINICODER_MODEL=google/gemini-2.5-flash

# Optional
# MINICODER_MAX_TURNS=25
# MINICODER_MOCK=1      # force the offline provider even with a key present
# AUTO_APPROVE=1        # skip permission prompts (sandboxes only)
